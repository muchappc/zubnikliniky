# ---- Supabase (Settings → API) ----
SUPABASE_URL=https://xxxx.supabase.co
# Tajný klíč – jen do Vercelu / lokálního .env, nikdy do kódu
SUPABASE_SERVICE_ROLE_KEY=
# Veřejné hodnoty pro administraci
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# ---- E-maily přes Resend (resend.com, doména zubnikliniky.cz ověřená v DNS) ----
RESEND_API_KEY=
MAIL_FROM=zubnikliniky.cz <info@zubnikliniky.cz>
# Kam chodí upozornění na recenze, poptávky a žádosti ordinací
ADMIN_EMAIL=

# ---- Ostatní ----
PUBLIC_SITE_URL=https://www.zubnikliniky.cz
# Libovolný dlouhý náhodný řetězec (pro anonymizaci e-mailů a IP v databázi)
HASH_SALT=
# Vercel → Project → Settings → Git → Deploy Hooks → vytvořit hook pro větev main
VERCEL_DEPLOY_HOOK_URL=
