---
const path = Astro.url.pathname;
const links = [
  { href: '/mesta', label: 'Města' },
  { href: '/obor/zubar', label: 'Obory' },
  { href: '/poradna', label: 'Poradna' },
  { href: '/o-nas', label: 'Jak to funguje' },
  { href: '/pro-zubare', label: 'Pro zubaře' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="zubnikliniky.cz – úvod">
      <img src="/logo.png" alt="zubnikliniky.cz" width="159" height="36" />
    </a>
    {path !== '/hledat' && (
      <form class="hsearch" action="/hledat" method="get" role="search">
        <input name="q" type="search" placeholder="Hledat ordinaci, lékaře, město…" aria-label="Hledat ordinaci" />
        <button type="submit" aria-label="Hledat"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
      </form>
    )}
    <nav class="nav" aria-label="Hlavní navigace">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
  </div>
</header>
<style>
  .logo img { display: block; height: 36px; width: auto; }
  .hsearch { display: flex; align-items: center; flex: 1 1 220px; max-width: 360px; margin: 0 18px; border: 1.5px solid var(--line, #d9e3e3); border-radius: 999px; background: #fff; overflow: hidden; }
  .hsearch input { border: 0; outline: 0; padding: 8px 4px 8px 14px; font: inherit; font-size: 0.93rem; width: 100%; min-width: 0; background: transparent; }
  .hsearch button { border: 0; background: transparent; padding: 6px 12px 6px 6px; color: var(--accent-ink); cursor: pointer; display: flex; }
  .hsearch:focus-within { border-color: var(--accent); }
  @media (max-width: 760px) { .hsearch { order: 3; flex-basis: 100%; max-width: none; margin: 10px 0 0; } }
</style>
