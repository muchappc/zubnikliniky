---
const path = Astro.url.pathname;
const links = [
  { href: '/mesta', label: 'Města' },
  { href: '/obor/zubar', label: 'Obory' },
  { href: '/o-nas', label: 'Jak to funguje' },
  { href: '/pro-zubare', label: 'Pro zubaře' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="zubnikliniky.cz – úvod">
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path fill="#0b6f70" d="M16 5c-2.2-1.6-5.3-2.4-8-.9C4.6 6 4.3 10.6 5.4 14.4c.8 2.8 1.4 5.2 1.8 8.3.4 3.1 1.1 5.3 2.7 5.3 1.9 0 2.3-3.3 3-6.2.5-2.1 1.4-3.2 3.1-3.2s2.6 1.1 3.1 3.2c.7 2.9 1.1 6.2 3 6.2 1.6 0 2.3-2.2 2.7-5.3.4-3.1 1-5.5 1.8-8.3 1.1-3.8.8-8.4-2.6-10.3-2.7-1.5-5.8-.7-8 .9Z"/><circle cx="23.5" cy="8.5" r="3.6" fill="#23875a" stroke="#fff" stroke-width="1.6"/></svg>
      <b>zubni<span>kliniky</span>.cz</b>
    </a>
    <nav class="nav" aria-label="Hlavní navigace">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
  </div>
</header>
