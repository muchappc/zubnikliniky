---
// Ilustrace pro případovou studii: telefon s reklamou a formulářem + kalendář s obsazenými termíny.
---
<svg viewBox="0 0 460 380" role="img" aria-label="Ilustrace: reklama s formulářem v telefonu a kalendář s obsazenými termíny" class="case-hero-svg">
  <defs>
    <linearGradient id="ch-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e3f1f0" />
      <stop offset="1" stop-color="#f1ecfb" />
    </linearGradient>
    <filter id="ch-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#06303b" flood-opacity="0.14" />
    </filter>
  </defs>
  <rect x="10" y="20" width="440" height="340" rx="36" fill="url(#ch-bg)" />

  <!-- Kalendář -->
  <g filter="url(#ch-shadow)">
    <rect x="200" y="70" width="220" height="230" rx="18" fill="#fff" />
    <rect x="200" y="70" width="220" height="46" rx="18" fill="#034758" />
    <rect x="200" y="98" width="220" height="18" fill="#034758" />
    <text x="222" y="100" font-family="Onest, sans-serif" font-size="16" font-weight="700" fill="#fff">Termíny nových pacientů</text>
    {Array.from({ length: 20 }).map((_, i) => {
      const col = i % 5, row = Math.floor(i / 5);
      const x = 218 + col * 40, y = 132 + row * 40;
      const free = i === 19;
      return (
        <g>
          <rect x={x} y={y} width="32" height="32" rx="8" fill={free ? '#fff' : '#e2f3ea'} stroke={free ? '#d9e3e1' : '#23875a'} stroke-width="1.5" />
          {!free && <path d={`M${x + 9} ${y + 16.5} l5 5 l9 -10`} fill="none" stroke="#23875a" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />}
        </g>
      );
    })}
  </g>

  <!-- Telefon s reklamou -->
  <g filter="url(#ch-shadow)">
    <rect x="44" y="48" width="176" height="300" rx="28" fill="#06303b" />
    <rect x="54" y="60" width="156" height="276" rx="20" fill="#fff" />
    <rect x="112" y="68" width="40" height="6" rx="3" fill="#d9e3e1" />
    <circle cx="74" cy="94" r="10" fill="#034758" />
    <rect x="90" y="88" width="70" height="7" rx="3.5" fill="#06303b" />
    <rect x="90" y="99" width="44" height="5" rx="2.5" fill="#b9c7c9" />
    <rect x="64" y="114" width="136" height="86" rx="10" fill="#e3f1f0" />
    <path d="M132 134c-4-3-10-4-15-1.6-6 3.4-6.5 11.6-4.6 18.4 1.4 5 2.5 9.3 3.2 14.8.7 5.5 2 9.4 4.8 9.4 3.4 0 4.1-5.9 5.4-11 .9-3.8 2.5-5.7 5.5-5.7s4.6 1.9 5.5 5.7c1.3 5.1 2 11 5.4 11 2.8 0 4.1-3.9 4.8-9.4.7-5.5 1.8-9.8 3.2-14.8 1.9-6.8 1.4-15-4.6-18.4-5-2.4-11-1.4-15 1.6Z" fill="#fff" />
    <rect x="64" y="210" width="120" height="8" rx="4" fill="#06303b" />
    <rect x="64" y="224" width="96" height="6" rx="3" fill="#b9c7c9" />
    <rect x="64" y="244" width="136" height="20" rx="6" fill="#fff" stroke="#d9e3e1" />
    <rect x="64" y="270" width="136" height="20" rx="6" fill="#fff" stroke="#d9e3e1" />
    <rect x="64" y="300" width="136" height="24" rx="12" fill="#034758" />
    <text x="132" y="316" text-anchor="middle" font-family="Onest, sans-serif" font-size="11" font-weight="700" fill="#fff">Mám zájem</text>
  </g>

  <!-- Bublina s novou poptávkou -->
  <g filter="url(#ch-shadow)">
    <rect x="262" y="290" width="172" height="50" rx="25" fill="#fff" />
    <circle cx="287" cy="315" r="14" fill="#23875a" />
    <text x="287" y="320" text-anchor="middle" font-family="Onest, sans-serif" font-size="14" font-weight="800" fill="#fff">+1</text>
    <text x="309" y="311" font-family="Onest, sans-serif" font-size="12" font-weight="700" fill="#06303b">Nová poptávka</text>
    <text x="309" y="327" font-family="Onest, sans-serif" font-size="11" fill="#4a6269">Ostrava · hygiena</text>
  </g>
</svg>
<style>
  .case-hero-svg { width: 100%; height: auto; display: block; }
</style>
