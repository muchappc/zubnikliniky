---
import { SITE } from '../lib/site';
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
const all = [{ name: 'Úvod', href: '/' }, ...items];
const ld = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.name, ...(it.href ? { item: new URL(it.href, SITE.url).toString() } : {}) })),
};
---
<nav class="crumbs wrap" aria-label="Drobečková navigace">
  <ol>{all.map((it) => <li>{it.href ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>)}</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
